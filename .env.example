# --- Base de données ---------------------------------------------------
# Local (docker compose) :
DATABASE_URL=postgres://ri:ri@localhost:5432/ri_proj
# Azure Database for PostgreSQL (TLS obligatoire) :
# DATABASE_URL=postgres://UTILISATEUR:MOTDEPASSE@SERVEUR.postgres.database.azure.com:5432/ri_proj?sslmode=require

# --- Serveur -----------------------------------------------------------
PORT=8080
LOG_LEVEL=info
# Passer à false pour ne pas appliquer les migrations au démarrage.
MIGRER_AU_DEMARRAGE=true

# --- Module d'acquisition de données (ADM) -----------------------------
# Sans cette clé le module est inactif et la saisie manuelle prend le relais.
ANTHROPIC_API_KEY=
ADM_MODELE=claude-opus-5

# --- Géocodage ---------------------------------------------------------
# Nominatim demande un User-Agent identifiant avec un contact.
GEOCODE_USER_AGENT=outil-pilotage-RI (contact: prenom.nom@adria.tm.fr)
